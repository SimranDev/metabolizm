# Copy to apps/admin/.env. Same database as the api (docker compose up -d).
DATABASE_URL=postgres://metabolizm:metabolizm@localhost:5432/metabolizm
PORT=4000

# Optional. Stamped into food_reviews.reviewer_id so a review decision has an
# author in the audit trail. This is a STOPGAP, not an authorization model —
# the admin tool has no auth and authorizes nothing. Set it to a real
# users.id if you want your decisions attributed; leave it unset and they are
# recorded with a null reviewer.
# ADMIN_REVIEWER_ID=
