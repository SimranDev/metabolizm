# Copy to apps/admin/.env. Same database as the api (docker compose up -d).
# This is the WRITE side — everything the admin tool creates or edits lands
# here, and the Sync tab refuses to run unless it is a local host.
DATABASE_URL=postgres://metabolizm:metabolizm@localhost:5432/metabolizm
PORT=4000

# Optional. The LIVE database, read-only source for the Sync tab: pull test
# accounts (and their diary/weight/groups) from production into your local
# database so you can reproduce what a real user sees. Never written to — every
# read runs in a `read only` transaction, and sync refuses to write anywhere but
# localhost, so a swapped pair fails loudly instead of pushing local test data
# into production. Get the URL from the Railway Postgres service's public
# connection string. Leave it unset and the Sync tab reports itself
# unconfigured; nothing else in this tool touches live.
# SOURCE_DATABASE_URL=postgres://user:pass@host.proxy.rlwy.net:12345/railway

# Optional. Stamped into food_reviews.reviewer_id so a review decision has an
# author in the audit trail. This is a STOPGAP, not an authorization model —
# the admin tool has no auth and authorizes nothing. Set it to a real
# users.id if you want your decisions attributed; leave it unset and they are
# recorded with a null reviewer.
# ADMIN_REVIEWER_ID=
